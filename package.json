{
  "name": "tanstack-start-example-basic",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "gatsby:maps": "node scripts/gatsby/maps/build.ts",
    "gatsby:check": "node scripts/gatsby/maps/build.ts --check && node scripts/gatsby/ground-lint.ts && node scripts/gatsby/quotes.ts && node scripts/gatsby/feel.ts --check && node scripts/gatsby/nsf/build.ts --check",
    "gatsby:solve": "node scripts/gatsby/solve.ts && node scripts/gatsby/intro-lint.ts",
    "gatsby:precision": "node scripts/gatsby/precision.ts --check",
    "gatsby:browser": "node scripts/gatsby/flow.ts && node scripts/gatsby/replay-check.ts && node scripts/gatsby/replay-check.ts --mutate && node scripts/gatsby/bots.ts",
    "gatsby:nes": "node scripts/gatsby/nes-check.ts",
    "gatsby:nsf": "node scripts/gatsby/nsf-check.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use": "^17.6.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "playwright": "1.56.1",
    "postcss": "^8.5.30",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@netlify/zip-it-and-ship-it": {
      "typescript": "^5.9.3"
    }
  }
}
